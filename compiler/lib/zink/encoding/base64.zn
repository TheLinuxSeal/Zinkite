package zink.encoding;

// Base64 (RFC 4648, STDLIB §8.4): the standard alphabet with padding, and the URL-safe
// one without. The loops are the runtime's (`zr_b64_encode`, `zr_b64_decode`): they
// handle whole groups with no exits, so the C compiler vectorizes them.
public class base64 {
    private static extern("zr_b64_encode") void cEncode(string bytes, i32 url, u8[..>]& out);
    private static extern("zr_b64_decode") u8 cDecode(string text, i32 url, u8[..>]& out);

    public static u8[.] encode(string bytes) {
        u8[..>] out = [];
        cEncode(bytes, 0, out);
        return out;
    }

    public static u8[.] encodeUrl(string bytes) {
        u8[..>] out = [];
        cEncode(bytes, 1, out);
        return out;
    }

    // Appends the decoded bytes to out. INVALID for a character outside the alphabet,
    // bad padding, a length that can't be base64, or leftover bits that aren't zero; then
    // out is as it was.
    public static void decode(string text, u8[..>]& out) {
        u8 st = cDecode(text, 0, out);
        return #st;
    }

    // Padding is optional.
    public static void decodeUrl(string text, u8[..>]& out) {
        u8 st = cDecode(text, 1, out);
        return #st;
    }
}
