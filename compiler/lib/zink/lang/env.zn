package zink.lang;

// The environment (STDLIB §2.3). Views from `get` are rooted at static: the runtime never
// frees environment text, so an earlier view keeps the old value after `set`.
public class env {
    private static extern("zr_env_get") string cGet(string name);
    private static extern("zr_env_set") u8 cSet(string name, string value, i32 unset);
    private static extern("zr_env_entry") string cEntry(i64 i);

    // MISSING when it isn't set.
    public static string get(string name) {
        string v = cGet(name);
        if (v.len == 0 && !has(name)) {
            return #status.MISSING "";
        }
        return v;
    }

    public static bool has(string name) {
        for (EnvVar v : all()) {
            if (v.name == name) {
                return true;
            }
        }
        return false;
    }

    // INVALID for an empty name or one with '='. Child processes inherit it (§5.1).
    public static void set(string name, string value) {
        u8 err = cSet(name, value, 0);
        return #err;
    }

    public static void unset(string name) {
        @_ = cSet(name, "", 1);
    }

    // Every variable, in the environment's order: for (EnvVar v : env.all()).
    public static EnvIterator all() {
        return new EnvIterator(0);
    }

    static string entry(i64 i) {
        return cEntry(i);
    }
}
