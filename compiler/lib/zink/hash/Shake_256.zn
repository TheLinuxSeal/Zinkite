package zink.hash;

// SHAKE256 (FIPS 202), an extendable-output function, for data that arrives in pieces
// (STDLIB §8.3): update with each, then finish with the length wanted.
public class Shake_256 {
    // The runtime's state, kept in the object (zr_digest).
    private u8[..~216] st = [];

    public new() {
        for (i64 i = 0; i < 216; i++) {
            @_ = st +> 0;
        }
        hash.start(st, 12);
    }

    public mut void update(string chunk) { hash.add(st, chunk); }

    // n bytes of output, as many as asked for. The object starts over afterwards. A
    // negative n fails with INVALID, gives no bytes, and leaves the object as it was.
    public mut u8[.] finish(i64 n) {
        u8[..>] out = [];
        if (n < 0) {
            return #status.INVALID out;
        }
        hash.squeeze(st, n, out);
        hash.start(st, 12);
        return out;
    }
}
