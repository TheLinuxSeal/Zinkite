package zink.io;

import zink.time.*;

// What fs.stat and fs.lstat say about a path (STDLIB §4.4).
public class Stat {
    public i64 size;
    public Timestamp modified;
    public u32 mode;
    public u32 uid;
    public u32 gid;
    public bool isDir;
    public bool isFile;
    public bool isLink;
}
