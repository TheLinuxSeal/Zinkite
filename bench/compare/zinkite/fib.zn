// fib: the naive doubly recursive Fibonacci. It measures function calls and
// nothing else: no memory, no data, two calls and an add per level.

i64 N = 32;                              // BENCH_N

i32 fib(i32 n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

void main() {
    println("${fib((i32) N)}");
}
