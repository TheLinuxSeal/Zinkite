// An image kernel: a 3x3 Gaussian blur over a WxW 8-bit image, ping-ponged
// between two buffers for 16 passes. Flat scalar data, a stencil of nine
// loads per pixel, and nothing for the memory model to win on: this row is
// here to measure what the safety checks cost.
//
// As in blur.goose, each access is `src[y * W + x]`, what everyone writes
// first. Zinkite checks every index and every addition (DESIGN §4.10, §9.2)
// and has no `checkfree` or bounds-check elimination of its own, so this is
// the checked kernel; the C compiler removes what it can prove. The image is
// a u8 array on a data stack, and the kernel takes a read-only slice and a
// writable view of the two buffers. blur_rows.zn is the same kernel over row
// slices.

i64 W = 2048;                            // BENCH_N
i64 PASSES = 16;

// xorshift64, the same generator as the Goose, C++ and Rust versions.
u64 xsNext(u64 x) {
    u64 v = x;
    v ^= v << 13;
    v ^= v >> 7;
    v ^= v << 17;
    return v;
}

i64 xsMod(u64 x, i64 k) { return (i64) (x % (u64) k); }

void blur(u8[:] src, u8[:]& dst) {
    for (i64 y = 1; y < W - 1; y++) {
        for (i64 x = 1; x < W - 1; x++) {
            i64 i = y * W + x;
            i32 s = (i32) src[i - W - 1] + (i32) src[i - W] * 2 + (i32) src[i - W + 1]
                  + (i32) src[i - 1] * 2 + (i32) src[i] * 4 + (i32) src[i + 1] * 2
                  + (i32) src[i + W - 1] + (i32) src[i + W] * 2 + (i32) src[i + W + 1];
            dst[i] = (u8) (s >> 4);
        }
    }
}

void main() {
    u8[..>] a = [];
    u8[..>] b = [];
    u64 r = 12345;
    for (i64 i = 0; i < W * W; i++) {
        r = xsNext(r);
        a +> (u8) xsMod(r, 256);
        b +> 0;
    }
    for (i64 p = 0; p < PASSES / 2; p++) {
        blur(a, b);
        blur(b, a);
    }
    i64 total = 0;
    for (u8 v : a) { total += v; }
    println("${W}");
    println("${total}");
}
