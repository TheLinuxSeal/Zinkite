// The blur of blur.zn written over row slices, as in blur_rows.goose: three
// source rows and one destination row are sliced once per row, and the inner
// loop indexes those. Each index is then a loop counter plus a constant
// against a slice of length W, which gives the C compiler the same loop C++
// has, though Zinkite still checks each index; any gap to blur.zn is how much
// of that the backend can prove away.

i64 W = 2048;                            // BENCH_N
i64 PASSES = 16;

// xorshift64, the same generator as the Goose, C++ and Rust versions.
u64 xsNext(u64 x) {
    u64 v = x;
    v ^= v << 13;
    v ^= v >> 7;
    v ^= v << 17;
    return v;
}

i64 xsMod(u64 x, i64 k) { return (i64) (x % (u64) k); }

void blur(u8[:] src, u8[:]& dst) {
    for (i64 y = 1; y < W - 1; y++) {
        i64 lo = (y - 1) * W;
        u8[:] a = src[lo:lo + W];
        u8[:] b = src[lo + W:lo + 2 * W];
        u8[:] c = src[lo + 2 * W:lo + 3 * W];
        u8[:]& d = dst[lo + W:lo + 2 * W];
        for (i64 x = 1; x < W - 1; x++) {
            i32 s = (i32) a[x - 1] + (i32) a[x] * 2 + (i32) a[x + 1]
                  + (i32) b[x - 1] * 2 + (i32) b[x] * 4 + (i32) b[x + 1] * 2
                  + (i32) c[x - 1] + (i32) c[x] * 2 + (i32) c[x + 1];
            d[x] = (u8) (s >> 4);
        }
    }
}

void main() {
    u8[..>] a = [];
    u8[..>] b = [];
    u64 r = 12345;
    for (i64 i = 0; i < W * W; i++) {
        r = xsNext(r);
        a +> (u8) xsMod(r, 256);
        b +> 0;
    }
    for (i64 p = 0; p < PASSES / 2; p++) {
        blur(a, b);
        blur(b, a);
    }
    i64 total = 0;
    for (u8 v : a) { total += v; }
    println("${W}");
    println("${total}");
}
