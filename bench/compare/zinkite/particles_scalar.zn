// A float kernel over an array of structs: N particles, 200 steps of f32
// vector math, then an integer checksum of where they ended up.
//
// The same simulation as particles.zn with the vector update written out
// component by component, which is the shape the C++ AoS row has, as in
// particles_scalar.goose. The two Zinkite rows differ only in expression
// style, so the gap between them is what the method form costs -- it adds
// gravity's zero x and z components that the written-out form skips.
//
// All the arithmetic is exact in binary32 -- positions are integers, velocities
// and gravity are multiples of 1/16, and the only multiply is by 0.5 -- so
// every implementation must produce a bit-identical checksum whatever the
// backend does with association or FMA.

i64 N = 200000;                          // BENCH_N
i64 STEPS = 200;

// xorshift64, the same generator as the Goose, C++ and Rust versions.
u64 xsNext(u64 x) {
    u64 v = x;
    v ^= v << 13;
    v ^= v >> 7;
    v ^= v << 17;
    return v;
}

i64 xsMod(u64 x, i64 k) { return (i64) (x % (u64) k); }

class V3 {
    f32 x;
    f32 y;
    f32 z;
}

class P {
    V3 pos;
    V3 vel;
}

void main() {
    P[..>] ps = [];
    u64 r = 12345;
    for (i64 i = 0; i < N; i++) {
        r = xsNext(r);
        f32 px = (f32) xsMod(r, 1024);
        f32 py = (f32) xsMod(r >> 12, 1024);
        f32 pz = (f32) xsMod(r >> 24, 1024);
        f32 vx = (f32) (xsMod(r >> 36, 256) - 128) / 16.0;
        f32 vy = (f32) (xsMod(r >> 44, 256) - 128) / 16.0;
        f32 vz = (f32) (xsMod(r >> 52, 256) - 128) / 16.0;
        ps +> new P(new V3(px, py, pz), new V3(vx, vy, vz));
    }
    for (i64 s = 0; s < STEPS; s++) {
        for (P& p : ps) {
            p.vel.y = p.vel.y - 0.0625;
            p.pos.x = p.pos.x + p.vel.x;
            p.pos.y = p.pos.y + p.vel.y;
            p.pos.z = p.pos.z + p.vel.z;
            if (p.pos.y < 0.0) {
                p.pos.y = 0.0 - p.pos.y;
                p.vel.y = 0.0 - p.vel.y * 0.5;
            }
        }
    }
    i64 total = 0;
    for (P& p : ps) {
        total += (i64) (p.pos.x * 16.0) + (i64) (p.pos.y * 16.0) + (i64) (p.pos.z * 16.0);
    }
    println("${ps.len}");
    println("${total}");
}
